# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Values set in the real environment (e.g. CI) take precedence over .env.

# --- Targets -----------------------------------------------------------------
# Web UI under test.
BASE_URL=https://www.demoblaze.com
# REST backend used by the UI and by API tests.
API_URL=https://api.demoblaze.com

# --- Credentials -------------------------------------------------------------
# Optional pre-existing account. Set both or neither. When unset, tests sign up
# a fresh unique user (prefix "qa_") through the API.
DEMOBLAZE_USERNAME=
DEMOBLAZE_PASSWORD=

# --- Execution ---------------------------------------------------------------
# Run browsers headless (true/false).
HEADLESS=true
# Parallel workers: integer or percentage of CPU cores (e.g. 50%). Empty = Playwright default.
WORKERS=
# Retries per failed test. Empty = 2 when CI is set, otherwise 0.
RETRIES=
# Set automatically by most CI systems; enables CI reporters and retries.
# CI=true
# CI only: suffix of the blob report file, unique per parallel job so merged reports don't collide.
BLOB_REPORT_NAME=local

# --- Timeouts (milliseconds) -------------------------------------------------
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
API_TIMEOUT_MS=15000

# --- API resilience ----------------------------------------------------------
# Extra attempts for API setup/teardown calls that fail transiently (network error,
# HTTP 429 or 5xx), with exponential backoff starting at 500 ms. Business errors
# ("Wrong password." etc.) are never retried. 0 disables.
API_RETRIES=2

# --- Performance budgets (milliseconds) --------------------------------------
# PerformanceNavigationTiming domContentLoadedEventEnd budget for key pages.
PERF_DCL_BUDGET_MS=5000
# PerformanceNavigationTiming loadEventEnd budget for key pages.
PERF_LOAD_BUDGET_MS=10000
# Response-time budget for key API calls.
PERF_API_BUDGET_MS=3000

# --- Global setup ------------------------------------------------------------
# Skip the GET /entries health check before the run (true/false).
SKIP_HEALTH_CHECK=false
